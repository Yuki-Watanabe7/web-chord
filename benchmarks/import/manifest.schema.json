{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-chord.local/schemas/import-benchmark-manifest-v1.json",
  "title": "web-chord import benchmark manifest",
  "type": "object",
  "required": ["schemaVersion", "benchmarkId", "ticksPerQuarter", "tolerances", "sources", "candidateSets"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "benchmarkId": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "ticksPerQuarter": { "type": "integer", "minimum": 1 },
    "tolerances": {
      "type": "object",
      "required": ["onsetTicks", "durationTicks"],
      "properties": {
        "onsetTicks": { "type": "integer", "minimum": 0 },
        "durationTicks": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "fileName", "localPath", "sha256", "pages", "origin", "redistribution", "difficultyRegions", "evaluationSegments"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "fileName": { "type": "string", "minLength": 1 },
          "localPath": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "pages": { "type": "integer", "minimum": 1 },
          "origin": { "type": "string", "minLength": 1 },
          "redistribution": { "const": "prohibited" },
          "difficultyRegions": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/region" }
          },
          "evaluationSegments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "allOf": [
                { "$ref": "#/$defs/region" },
                {
                  "type": "object",
                  "required": ["id", "fixture"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "fixture": { "type": "string", "minLength": 1 }
                  }
                }
              ]
            }
          }
        },
        "additionalProperties": false
      }
    },
    "candidateSets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "converter", "directory"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "converter": {
            "type": "object",
            "required": ["name", "version", "options"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "options": { "type": "object" }
            },
            "additionalProperties": false
          },
          "directory": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "region": {
      "type": "object",
      "required": ["measureStart", "measureEnd", "difficultyTags"],
      "properties": {
        "measureStart": { "type": "integer", "minimum": 1 },
        "measureEnd": { "type": "integer", "minimum": 1 },
        "difficultyTags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
