{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://web-chord.local/schemas/import-benchmark-fixture-v1.json",
  "title": "web-chord import benchmark fixture",
  "type": "object",
  "required": ["schemaVersion", "scoreId", "segment", "ppq", "measures", "chords", "melody", "structure"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "scoreId": { "type": "string", "minLength": 1 },
    "segment": {
      "type": "object",
      "required": ["id", "sourcePage", "sourceSystem", "measureStart", "measureEnd"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourcePage": { "type": "integer", "minimum": 1 },
        "sourceSystem": { "type": "integer", "minimum": 1 },
        "measureStart": { "type": "integer", "minimum": 1 },
        "measureEnd": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "ppq": { "type": "integer", "minimum": 1 },
    "measures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "durationTicks", "timeSignature", "key", "tempoBpm", "pickupTicks"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "durationTicks": { "type": "integer", "minimum": 1 },
          "timeSignature": { "anyOf": [{ "$ref": "#/$defs/timeSignatureValue" }, { "type": "null" }] },
          "key": { "anyOf": [{ "$ref": "#/$defs/keyValue" }, { "type": "null" }] },
          "tempoBpm": { "type": ["number", "null"], "exclusiveMinimum": 0 },
          "pickupTicks": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "chords": {
      "type": "array",
      "items": { "$ref": "#/$defs/chord" }
    },
    "melody": {
      "type": "array",
      "items": { "$ref": "#/$defs/note" }
    },
    "structure": {
      "type": "object",
      "required": ["timeSignatures", "keys", "tempos", "navigation", "playbackOrder"],
      "properties": {
        "timeSignatures": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/position" },
              { "$ref": "#/$defs/timeSignatureValue" }
            ]
          }
        },
        "keys": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/position" },
              { "$ref": "#/$defs/keyValue" }
            ]
          }
        },
        "tempos": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/position" },
              {
                "type": "object",
                "required": ["bpm"],
                "properties": { "bpm": { "type": "number", "exclusiveMinimum": 0 } }
              }
            ]
          }
        },
        "navigation": {
          "type": "array",
          "items": {
            "allOf": [
              { "$ref": "#/$defs/position" },
              {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": ["repeatStart", "repeatEnd", "endingStart", "endingStop", "segno", "dalSegno", "coda", "toCoda", "fine"]
                  },
                  "targetMeasure": { "type": ["integer", "null"], "minimum": 1 },
                  "endingNumbers": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 1 }
                  },
                  "repeatCount": { "type": ["integer", "null"], "minimum": 2 }
                }
              }
            ]
          }
        },
        "playbackOrder": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["measure", "field", "code", "message"],
        "properties": {
          "measure": { "type": "integer", "minimum": 1 },
          "field": { "type": "string", "minLength": 1 },
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "position": {
      "type": "object",
      "required": ["measure", "onsetTick"],
      "properties": {
        "measure": { "type": "integer", "minimum": 1 },
        "onsetTick": { "type": "integer", "minimum": 0 }
      }
    },
    "timeSignatureValue": {
      "type": "object",
      "required": ["beats", "beatType"],
      "properties": {
        "beats": { "type": "integer", "minimum": 1 },
        "beatType": { "type": "integer", "enum": [1, 2, 4, 8, 16] }
      }
    },
    "keyValue": {
      "type": "object",
      "required": ["fifths", "mode"],
      "properties": {
        "fifths": { "type": "integer", "minimum": -7, "maximum": 7 },
        "mode": { "type": "string", "enum": ["major", "minor"] }
      }
    },
    "chord": {
      "type": "object",
      "required": ["measure", "onsetTick", "durationTicks", "symbol", "root", "bass", "quality"],
      "properties": {
        "measure": { "type": "integer", "minimum": 1 },
        "onsetTick": { "type": "integer", "minimum": 0 },
        "durationTicks": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "bass": { "type": ["string", "null"] },
        "quality": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "note": {
      "type": "object",
      "required": ["measure", "onsetTick", "durationTicks", "midi", "tie"],
      "properties": {
        "measure": { "type": "integer", "minimum": 1 },
        "onsetTick": { "type": "integer", "minimum": 0 },
        "durationTicks": { "type": "integer", "minimum": 1 },
        "midi": { "type": "integer", "minimum": 0, "maximum": 127 },
        "tie": { "type": "string", "enum": ["none", "start", "continue", "stop"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
